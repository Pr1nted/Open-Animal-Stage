+// ── A STAGE: several seats in one world (Open Animal Stage) ──
+//
+//   od_agent_stage_begin("1914:rung", "FRA,GER,SWE", seed, 120) -> seats, 0 on failure
+//   od_agent_seat_position(seat, withMap)                        -> JSON, as above
+//   od_agent_seat_play(seat, "e:1,w:2")                           -> JSON, as above
+//
+// Seats are indices into the ISO list. od_agent_end_turn resolves the turn for
+// the whole world, once every seat has played.
+EMSCRIPTEN_KEEPALIVE int od_agent_stage_begin(const char* mapSpec, const char* isoCsv,
+                                              unsigned int seed, int turns) {
+    std::vector<std::string> isos;
+    std::string csv = isoCsv ? isoCsv : "", tok;
+    for (size_t at = 0; at <= csv.size(); ++at) {
+        if (at == csv.size() || csv[at] == ',') { if (!tok.empty()) isos.push_back(tok); tok.clear(); }
+        else if (csv[at] != ' ') tok.push_back(csv[at]);
+    }
+    g_game.reset();
+    g_game = std::make_unique<Game>();
+    if (!g_game->agentUseDataDir("/data/")) return 0;
+    return g_game->agentBeginStage(mapSpec ? mapSpec : "", isos, seed, turns);
+}
+
+EMSCRIPTEN_KEEPALIVE const char* od_agent_seat_position(int seat, int withMap) {
+    g_out = (g_game && g_game->agentSeatCid(seat) > 0)
+                ? g_game->agentPositionJsonFor(g_game->agentSeatCid(seat), withMap != 0)
+                : std::string("null");
+    return g_out.c_str();
+}
+
+EMSCRIPTEN_KEEPALIVE const char* od_agent_seat_play(int seat, const char* tokens) {
+    nlohmann::json moves = nlohmann::json::array();
+    if (g_game && g_game->agentSeatCid(seat) > 0) {
+        for (const Game::AgentMove& m : g_game->agentPlayFor(g_game->agentSeatCid(seat), tokens ? tokens : ""))
+            moves.push_back({{"token", m.token}, {"outcome", m.outcome}, {"detail", m.detail}});
+    }
+    g_out = moves.dump();
+    return g_out.c_str();
+}
+
 EMSCRIPTEN_KEEPALIVE unsigned int od_agent_map_seed() {
     return g_game ? g_game->agentMapSeed() : 0;
 }
