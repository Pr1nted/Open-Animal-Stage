+int Game::agentBeginStage(const std::string& mapSpec, const std::vector<std::string>& isos,
+                          unsigned int seed, int untilTurn) {
+    m_agentSeats.clear();
+    if (isos.empty()) return 0;
+    // mapSpec is "map[:world]"; agentBegin wants "map:ISO[:world]". The first
+    // seat's country is only what the load needs to start from -- it stops
+    // being the player below.
+    std::string map = mapSpec, world;
+    const size_t odmapEnd = mapSpec.find(".odmap");
+    const size_t colon = mapSpec.find(':', odmapEnd == std::string::npos ? 0 : odmapEnd);
+    if (colon != std::string::npos) {
+        map = mapSpec.substr(0, colon);
+        world = mapSpec.substr(colon + 1);
+    }
+    if (!agentBegin(map + ":" + isos[0] + (world.empty() ? "" : ":" + world), seed, untilTurn))
+        return 0;
+    for (const std::string& iso : isos) {
+        const int cid = cidForIso(iso);
+        // Two seats on one country is not a pairing but a race: the game would
+        // take whichever orders arrived last. Refused, as the stage refuses it.
+        if (cid <= 0 || !m_countries.getCountry(cid) || isAgentSeat(cid)) {
+            fprintf(stderr, "[AGENT] stage seat %s: %s\n", iso.c_str(),
+                    cid > 0 && isAgentSeat(cid) ? "taken twice" : "no such country");
+            m_agentSeats.clear();
+            return 0;
+        }
+        m_agentSeats.push_back(cid);
+    }
+    // THE PAGE WATCHES; NOBODY IS THE PLAYER. The player's country skips the
+    // AI's research and gets the player's own paths through turn resolution,
+    // so a seat that was the player would be playing a different game from the
+    // seats beside it. The spectator is how the game starts before a country is
+    // picked, so this is a state it already knows.
+    m_playerCountryId = SPC_CID;
+    return (int)m_agentSeats.size();
+}
